# Expo + React Native need a flat node_modules layout to resolve
# their internal scripts and metro module graph correctly. pnpm's
# default isolated layout breaks `react-native-screens` postinstall
# and Metro's resolver. This is the official Expo recommendation
# for pnpm monorepos.
node-linker=hoisted
shamefully-hoist=true

# Keep installs deterministic
strict-peer-dependencies=false
auto-install-peers=true
