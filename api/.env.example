# --- Server ---
PORT=3001

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=svbk
# Schema changes go through migrations. Leave DB_SYNC unset (or false)
# unless you're explicitly bootstrapping a fresh dev DB.
DB_SYNC=false

# --- JWT ---
# Access token expiry in SECONDS. Keep short (15m) — refresh handles the rest.
JWT_SECRET=change_me
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=604800

# --- Parent OTP login ---
OTP_EXPIRES_IN_MINUTES=5
DEMO_MODE=true   # any 6-digit code works; OTPs are logged, not emailed

# --- SMTP for OTP delivery (used when DEMO_MODE=false) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SVBK <no-reply@svbk.edu.in>
SMTP_ALLOW_INSECURE=false

# --- Payments (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Per-tenant Cashfree mode is driven by tenant_configurations.payment_mode
# (production → live, anything else → sandbox). No env var needed.

# --- Cloudinary (optional, for media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Local upload fallback (chat attachments) ---
# When a tenant has no Azure storage configured, chat file uploads are
# written here and served from {PUBLIC_API_BASE_URL}/uploads/... Defaults to
# ./uploads next to the API process. For real deployments configure each
# tenant's storage connection string instead.
LOCAL_UPLOAD_DIR=

# --- Web client URL (used for emails / templating + Cashfree return_url) ---
CLIENT_URL=http://localhost:3000

# --- Public API base URL (used for Cashfree notify_url / webhooks) ---
# Cashfree calls this URL when a payment completes. Must be HTTPS in
# production; localhost is fine in dev but a real Cashfree won't be
# able to reach it (use ngrok or similar to test webhooks locally).
PUBLIC_API_BASE_URL=http://localhost:3001

# --- CORS — comma-separated origins. Use "*" or leave empty to allow all (dev only). ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# --- Sentry (optional) ---
# Set SENTRY_DSN to enable exception forwarding. Leave empty in dev.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# --- DB connection pool (override defaults for prod scale) ---
DB_POOL_MAX=30
DB_POOL_MIN=5
