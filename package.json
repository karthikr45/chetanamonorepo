{
  "name": "svbkmonorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "react-native-screens"
    ],
    "overrides": {
      "@svbk/mobile-parent>react": "18.2.0",
      "react-native>react": "18.2.0"
    }
  }
}
